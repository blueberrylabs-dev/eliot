{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "eliot-banc-essai",
  "version": "0.1.0",
  "identifier": "fr.alexandredo.eliot.banc",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Banc d'essai Eliot (moteur web d'Ubuntu)",
        "width": 1440,
        "height": 900,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
