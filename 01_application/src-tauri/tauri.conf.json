{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eliot",
  "version": "0.1.0",
  "identifier": "fr.alexandredo.eliot",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Eliot",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Graphics",
    "shortDescription": "Éditeur graphique de bureau",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
